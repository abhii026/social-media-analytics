# 1. Telegram Public Channel Collector (Authorized MTProto Client API)
# Required to ingest real public data from channels (@techcrunch, @cybersecurity_news, etc.)
# Obtain api_id and api_hash from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 2. Telegram Bot Pipeline (Test & Verification Only)
# Used strictly to test the live ingestion pipeline.
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=devorbit_db

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 3. Instagram / Meta Graph API Configuration (Official API Only)
# Required to ingest real Instagram data from authorized Professional/Creator accounts
# Obtain User/Page Access Token and Account ID from https://developers.facebook.com
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=devorbit_verify_token
META_APP_SECRET=
